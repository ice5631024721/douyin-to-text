#!/bin/sh
# omnisub 启动器：找一个 **Python 3.10+** 解释器再跑 scripts/omnisub.py。
#
# 为什么需要它（实测，2026-09-27）：DSH 的 bash 子进程 PATH 只有 /usr/bin:/bin:/usr/sbin:/sbin，
# 裸 `python3` 落到系统自带的 **3.9.6**，而 omnisub 要 3.10+（用了 Path.write_text(newline=)、
# `X | None` 等）→ 文档里那条 `python3 …/omnisub.py` 在 DSH 里直接跑不起来。
# uv 托管的 3.12 在 ~/.local/bin，但**不在 DSH 的 PATH 里**，所以这里按序找，别让人每次先 export。
set -e
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for py in "$HOME/.local/bin/python3" \
          "$HOME/.local/share/uv/python/"*/bin/python3 \
          /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.12 \
          python3.13 python3.12 python3.11 python3.10 \
          /opt/homebrew/bin/python3 python3; do
    [ -x "$py" ] || continue
    if "$py" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
        exec "$py" "$here/scripts/omnisub.py" "$@"
    fi
done

echo "omnisub: 找不到 Python 3.10+ 解释器（DSH 里裸 python3 通常是 3.9）。" >&2
echo "  已按序找过：~/.local/bin/python3、uv python 目录、/opt/homebrew 的 3.13/3.12、PATH 里的 3.13～3.10" >&2
echo "  装一个即可：uv python install 3.12   （uv 在 ~/.local/bin）" >&2
exit 2